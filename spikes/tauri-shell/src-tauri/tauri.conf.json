{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VELFORT Spike",
  "version": "0.0.1",
  "identifier": "app.velfort.spike",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "VELFORT Spike", "width": 800, "height": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost",
      "pattern": { "use": "isolation", "options": { "dir": "../isolation" } },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "VELFORT spike",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "perMachine" }
    }
  }
}
